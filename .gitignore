/planning/src
CATKIN_IGNORE

# Generated documentation
*.dox
*.wikidoc

# Large raw media inside dataset directories. Dataset Markdown documents and
# lightweight camera/scene/rigid-body configuration files remain trackable.
/dataset*/**/images/
/dataset*/**/videos/
/dateset*/**/images/
/dateset*/**/videos/
/dataset*/**/overlays/
/dateset*/**/overlays/

# Large per-frame ground-truth and visibility records
/dataset*/**/gt_2d.json
/dataset*/**/gt_2d_frames.json
/dataset*/**/gt_3d.json
/dataset*/**/gt_3d_frames.json
/dataset*/**/object_pose_frames.json
/dataset*/**/visibility.json
/dataset*/**/distance_frames.json
/dataset*/**/coverage_frames.json
/dataset*/**/observation_quality_frames.json
/dateset*/**/gt_2d.json
/dateset*/**/gt_2d_frames.json
/dateset*/**/gt_3d.json
/dateset*/**/gt_3d_frames.json
/dateset*/**/object_pose_frames.json
/dateset*/**/visibility.json
/dateset*/**/distance_frames.json
/dateset*/**/coverage_frames.json
/dateset*/**/observation_quality_frames.json

# Algorithm outputs stored inside datasets
/dataset*/**/algorithm_output/
/dateset*/**/algorithm_output/

# Generated evaluation artifacts. Named Markdown analysis reports remain
# trackable; auto-generated RESULTS.md files and machine-readable bulk outputs
# are reproducible and are ignored.
/output-lkf*/**/*.json
/output-lkf*/**/*.csv
/output-lkf*/**/*.png
/output-lkf*/**/*.mp4
/output-lkf*/**/*.log
/output-lkf*/**/RESULTS.md

# Captures, point clouds and middleware recordings
*.pcd
*.bag
*.bag.active
*.db3
*.mcap

# Local archives and temporary files
*.zip
*.tar
*.tar.gz
*.tgz
*.7z
*.tmp
*.temp
